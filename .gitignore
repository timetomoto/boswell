# Dependencies
node_modules/

# wp-env local state (docker volumes and download cache live under ~/.wp-env,
# but @wordpress/env also writes a lockfile here)
.wp-env.override.json

# Build output
dist/
build/
# Block-editor build output is checked in so the theme is drop-in for a
# non-developer owner — no npm build required after clone / pull.
!theme/bozzies/blocks/*/build/
!theme/bozzies/blocks/*/build/**

# Editor / OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env
.env
.env.local
.env.*.local

# Local credentials — never commit
admin-credentials.txt

# Screenshots for visual QA (local only)
_screens/

# Import script staging area (host-writable, container-readable via theme mount)
theme/bozzies/.import-tmp/

# Dev-only mu-plugins loaded by wp-env via .wp-env.override.json mapping —
# rewrites siteurl/home to whatever host WordPress is reached at, so the
# local site works from a phone at http://<Mac IP>:8888. Kept out of git per
# CLAUDE.md rules (never shipped). The .example.php next to it IS tracked.
dev-tools/mu-plugins/
