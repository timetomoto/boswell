{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bozzies/release-cards",
	"version": "1.0.0",
	"title": "Press releases grid",
	"category": "boz-custom-component",
	"icon": "media-document",
	"description": "The gold-ground grid of dark-purple press-release cards on the Press hub. Contains bozzies/release-card children; renders Astro's exact <section class=\"section ground-gold press-releases\"> with a staves music-backdrop, <header class=\"releases-head\"> and <ul class=\"releases-grid\"> DOM.",
	"textdomain": "bozzies",
	"supports": {
		"anchor": true,
		"html": false,
		"className": true,
		"customClassName": true,
		"reusable": true,
		"inserter": true,
		"align": [
			"full"
		]
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"blurb": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php",
	"example": {
		"attributes": {
			"eyebrow": "The Press Room",
			"title": "Press releases & media",
			"blurb": "Original press releases, event announcements, and archival documents. Each opens as a PDF."
		},
		"innerBlocks": [
			{
				"name": "bozzies/release-card",
				"attributes": {
					"documentType": "PDF",
					"title": "Boswell Sisters Centennial Program, 2025",
					"releaseDate": "2025-03-01",
					"href": ""
				}
			},
			{
				"name": "bozzies/release-card",
				"attributes": {
					"documentType": "PDF",
					"title": "Boswell Sisters Tribute Dinner",
					"releaseDate": "2024-10-14",
					"href": ""
				}
			},
			{
				"name": "bozzies/release-card",
				"attributes": {
					"documentType": "PDF",
					"title": "Centennial Press Release",
					"releaseDate": "2024-06-03",
					"href": ""
				}
			}
		]
	}
}
