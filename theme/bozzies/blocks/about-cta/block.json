{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bozzies/about-cta",
	"version": "1.0.0",
	"title": "About CTA",
	"category": "design",
	"icon": "email-alt",
	"description": "The centered contact + donate call-to-action on the About page. Ground-gold with the notes backdrop, purple eyebrow, two-button row (outline Contact + filled Donate).",
	"textdomain": "bozzies",
	"supports": {
		"anchor": true,
		"html": false,
		"className": true,
		"customClassName": true,
		"reusable": true,
		"inserter": true,
		"align": [ "full" ]
	},
	"attributes": {
		"align":           { "type": "string", "default": "full" },
		"eyebrow":         { "type": "string", "default": "Get in touch" },
		"title":           { "type": "string", "default": "" },
		"body":            { "type": "string", "default": "" },
		"contactHref":     { "type": "string", "default": "" },
		"contactLabel":    { "type": "string", "default": "Contact" },
		"donateHref":      { "type": "string", "default": "" },
		"donateLabel":     { "type": "string", "default": "Donate" }
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
