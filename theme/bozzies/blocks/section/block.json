{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bozzies/section",
	"version": "1.0.0",
	"title": "Section",
	"category": "design",
	"icon": "align-full-width",
	"description": "Full-bleed section with ground color, optional background image and pattern, width, heading width, spacing, and hero options.",
	"textdomain": "bozzies",
	"supports": {
		"anchor": true,
		"align": [ "full", "wide" ],
		"html": false,
		"className": true,
		"customClassName": true,
		"reusable": true,
		"inserter": true
	},
	"attributes": {
		"align": { "type": "string", "default": "full" },
		"backgroundStyle": { "type": "string", "default": "paper" },
		"customBackground": { "type": "string", "default": "" },
		"backgroundImage": { "type": "object", "default": null },
		"backgroundFocalPoint": { "type": "object", "default": { "x": 0.5, "y": 0.5 } },
		"overlayColor": { "type": "string", "default": "#181615" },
		"overlayStrength": { "type": "number", "default": 70 },
		"backdrop": { "type": "string", "default": "none" },
		"backdropColor": { "type": "string", "default": "" },
		"width": { "type": "string", "default": "container" },
		"headingWidth": { "type": "string", "default": "container" },
		"spacing": { "type": "string", "default": "standard" },
		"heroFrame": { "type": "boolean", "default": false },
		"imageGrayscale": { "type": "boolean", "default": false },
		"imageZoom": { "type": "boolean", "default": false },
		"heroPhoto": { "type": "boolean", "default": false }
	},
	"editorScript": "file:./build/index.js",
	"style": "file:./build/style-index.css",
	"render": "file:./render.php"
}
