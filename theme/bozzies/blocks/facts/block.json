{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bozzies/facts",
	"version": "1.0.0",
	"title": "Facts strip",
	"category": "boz-custom-component",
	"icon": "list-view",
	"description": "Astro's `.facts-strip` — a museum-label style dt/dd definition list, used on sister bios. Contains bozzies/fact children; renders <section class=\"section-tight ground-paper facts-strip\"><div class=\"container\"><dl class=\"facts\">…</dl></div></section>.",
	"textdomain": "bozzies",
	"supports": {
		"anchor": true,
		"html": false,
		"className": true,
		"customClassName": true,
		"reusable": true,
		"inserter": true
	},
	"attributes": {},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php",
	"example": {
		"attributes": {},
		"innerBlocks": [
			{
				"name": "bozzies/fact",
				"attributes": {
					"label": "Born",
					"value": "Dec 3, 1907 — New Orleans"
				}
			},
			{
				"name": "bozzies/fact",
				"attributes": {
					"label": "Died",
					"value": "Oct 11, 1976 — New York City"
				}
			},
			{
				"name": "bozzies/fact",
				"attributes": {
					"label": "Instrument",
					"value": "Voice, cello"
				}
			},
			{
				"name": "bozzies/fact",
				"attributes": {
					"label": "Years active",
					"value": "1925 — 1957"
				}
			}
		]
	}
}
