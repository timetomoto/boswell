{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bozzies/lesson-nav",
	"version": "1.0.0",
	"title": "Lesson nav",
	"category": "design",
	"icon": "controls-play",
	"description": "Astro's lesson-page bottom navigation — <nav class=\"section-tight ground-paper lesson-nav\"> with prev / all / next links inside a 1fr/auto/1fr grid.",
	"textdomain": "bozzies",
	"supports": {
		"anchor": true,
		"html": false,
		"className": true,
		"customClassName": true,
		"reusable": true,
		"inserter": true,
		"align": [ "full" ]
	},
	"attributes": {
		"prevHref":   { "type": "string", "default": "" },
		"prevLabel":  { "type": "string", "default": "Previous" },
		"prevName":   { "type": "string", "default": "" },
		"allHref":    { "type": "string", "default": "/media/" },
		"allLabel":   { "type": "string", "default": "All" },
		"allName":    { "type": "string", "default": "Lessons" },
		"nextHref":   { "type": "string", "default": "" },
		"nextLabel":  { "type": "string", "default": "Next" },
		"nextName":   { "type": "string", "default": "" },
		"ariaLabel":  { "type": "string", "default": "Lessons navigation" }
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
