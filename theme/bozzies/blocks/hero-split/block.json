{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bozzies/hero-split",
	"version": "1.0.0",
	"title": "Hero (split)",
	"category": "design",
	"icon": "align-pull-left",
	"description": "Home page hero — image on the left, purple text panel on the right, stacked on mobile. Emits Astro's exact hero--split DOM.",
	"textdomain": "bozzies",
	"supports": {
		"anchor": true,
		"html": false,
		"className": true,
		"customClassName": true,
		"reusable": true,
		"inserter": true,
		"align": [ "full" ]
	},
	"attributes": {
		"align":       { "type": "string", "default": "full" },
		"eyebrow":     { "type": "string", "default": "" },
		"title":       { "type": "string", "default": "" },
		"subtitle":    { "type": "string", "default": "" },
		"tagline":     { "type": "string", "default": "" },
		"image":       { "type": "object", "default": null },
		"imageAlt":    { "type": "string", "default": "" },
		"imageCredit": { "type": "string", "default": "" },
		"height":      { "type": "string", "default": "tall" }
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
