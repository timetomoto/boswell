{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bozzies/page-hero",
	"version": "1.0.0",
	"title": "Page hero (purple)",
	"category": "design",
	"icon": "cover-image",
	"description": "Compact purple hero with a back-link, optional eyebrow, h1 title and optional subtitle. Use at the top of section subpages (career-timeline, discography, reviews, charts, bio-resources).",
	"textdomain": "bozzies",
	"supports": {
		"anchor": true,
		"html": false,
		"className": true,
		"customClassName": true,
		"reusable": true,
		"inserter": true,
		"align": [ "full" ]
	},
	"attributes": {
		"align":     { "type": "string", "default": "full" },
		"backHref":  { "type": "string", "default": "/" },
		"backLabel": { "type": "string", "default": "Home" },
		"eyebrow":   { "type": "string", "default": "" },
		"title":     { "type": "string", "default": "" },
		"subtitle":  { "type": "string", "default": "" }
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
