{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bozzies/fact",
	"version": "1.0.0",
	"title": "Fact",
	"category": "design",
	"icon": "editor-textcolor",
	"parent": [ "bozzies/facts" ],
	"description": "One museum-label fact — a `<dt>`/`<dd>` pair inside the facts strip. Label and value are inline-editable.",
	"textdomain": "bozzies",
	"supports": {
		"html": false,
		"reusable": false,
		"inserter": true,
		"className": false,
		"customClassName": false
	},
	"attributes": {
		"label": { "type": "string", "default": "" },
		"value": { "type": "string", "default": "" }
	},
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
