{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "42rem",
			"wideSize": "60rem"
		},
		"color": {
			"background": true,
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"link": true,
			"text": true,
			"palette": [
				{ "slug": "ink",                 "name": "Ink",                 "color": "#181615" },
				{ "slug": "ink-soft",            "name": "Ink soft",            "color": "#2A2724" },
				{ "slug": "paper",               "name": "Paper",               "color": "#F4F0E8" },
				{ "slug": "paper-shadow",        "name": "Paper shadow",        "color": "#E8E1D3" },
				{ "slug": "paper-warm",          "name": "Paper warm",          "color": "#F5EAD1" },
				{ "slug": "brass",               "name": "Brass",               "color": "#7A5F32" },
				{ "slug": "brass-bright",        "name": "Brass bright",        "color": "#B08D57" },
				{ "slug": "champagne",           "name": "Champagne",           "color": "#C8A96A" },
				{ "slug": "oxblood",             "name": "Oxblood",             "color": "#5A2E2E" },
				{ "slug": "emerald",             "name": "Emerald",             "color": "#23453A" },
				{ "slug": "navy",                "name": "Navy",                "color": "#22344B" },
				{ "slug": "copper",              "name": "Copper",              "color": "#7C4E30" },
				{ "slug": "copper-bright",       "name": "Copper bright",       "color": "#9C6844" },
				{ "slug": "purple",              "name": "Purple",              "color": "#4A2E5A" },
				{ "slug": "purple-soft",         "name": "Purple soft",         "color": "#6C4E7F" },
				{ "slug": "yellow",              "name": "Yellow",              "color": "#8F6C1D" },
				{ "slug": "yellow-bright",       "name": "Yellow bright",       "color": "#C99A2A" },
				{ "slug": "yellow-soft",         "name": "Yellow soft",         "color": "#E1C263" },
				{ "slug": "yellow-hover",        "name": "Yellow hover",        "color": "#F5DE8C" },
				{ "slug": "text-on-ink",         "name": "Text on ink",         "color": "#EDE6D6" },
				{ "slug": "text-on-ink-muted",   "name": "Text on ink muted",   "color": "rgba(237, 230, 214, 0.62)" },
				{ "slug": "text-on-paper",       "name": "Text on paper",       "color": "#1E1B18" },
				{ "slug": "text-on-paper-muted", "name": "Text on paper muted", "color": "rgba(30, 27, 24, 0.78)" },
				{ "slug": "link",                "name": "Link",                "color": "#0044AA" },
				{ "slug": "link-hover",          "name": "Link hover",          "color": "#002F80" },
				{ "slug": "link-on-dark",        "name": "Link on dark",        "color": "#9EC5FF" },
				{ "slug": "link-on-dark-hover",  "name": "Link on dark hover",  "color": "#C0DBFF" },
				{ "slug": "ink-hairline",        "name": "Ink hairline",        "color": "rgba(176, 141, 87, 0.28)" },
				{ "slug": "paper-hairline",      "name": "Paper hairline",      "color": "rgba(24, 22, 21, 0.14)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"customFontSize": true,
			"lineHeight": true,
			"letterSpacing": true,
			"dropCap": false,
			"textDecoration": true,
			"textTransform": true,
			"fontStyle": true,
			"fontWeight": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Cormorant Garamond",
					"fontFamily": "'Cormorant Garamond', Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "300",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/cormorant-garamond-latin-300-normal.woff2"]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/cormorant-garamond-latin-400-normal.woff2"]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/cormorant-garamond-latin-500-normal.woff2"]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "italic",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/cormorant-garamond-latin-500-italic.woff2"]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/cormorant-garamond-latin-600-normal.woff2"]
						}
					]
				},
				{
					"slug": "body",
					"name": "Source Serif 4",
					"fontFamily": "'Source Serif 4', Charter, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "300",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/source-serif-4-latin-300-normal.woff2"]
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/source-serif-4-latin-400-normal.woff2"]
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/source-serif-4-latin-400-italic.woff2"]
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/source-serif-4-latin-500-normal.woff2"]
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/source-serif-4-latin-600-normal.woff2"]
						}
					]
				},
				{
					"slug": "ui",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, 'Helvetica Neue', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-latin-400-normal.woff2"]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-latin-400-italic.woff2"]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-latin-500-normal.woff2"]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "italic",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-latin-500-italic.woff2"]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-latin-600-normal.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "step--2", "name": "Step -2 (11.1px)", "size": "0.694rem" },
				{ "slug": "step--1", "name": "Step -1 (13.3px)", "size": "0.833rem" },
				{ "slug": "step-0",  "name": "Step 0 (body, 18px)", "size": "1rem" },
				{ "slug": "step-1",  "name": "Step 1 (22.5px)",   "size": "1.25rem" },
				{ "slug": "step-2",  "name": "Step 2 (28.1px)",   "size": "1.563rem" },
				{ "slug": "step-3",  "name": "Step 3 (35.2px)",   "size": "1.953rem" },
				{ "slug": "step-4",  "name": "Step 4 (43.9px)",   "size": "2.441rem" },
				{ "slug": "step-5",  "name": "Step 5 (54.9px)",   "size": "3.052rem" },
				{ "slug": "step-6",  "name": "Step 6 (68.7px)",   "size": "3.815rem" },
				{ "slug": "step-7",  "name": "Step 7 (85.8px)",   "size": "4.768rem" },
				{ "slug": "step-8",  "name": "Step 8 (hero, 107px)", "size": "5.96rem" }
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{ "slug": "1",  "name": "1 (4px)",   "size": "0.25rem" },
				{ "slug": "2",  "name": "2 (8px)",   "size": "0.5rem" },
				{ "slug": "3",  "name": "3 (12px)",  "size": "0.75rem" },
				{ "slug": "4",  "name": "4 (16px)",  "size": "1rem" },
				{ "slug": "5",  "name": "5 (24px)",  "size": "1.5rem" },
				{ "slug": "6",  "name": "6 (32px)",  "size": "2rem" },
				{ "slug": "7",  "name": "7 (48px)",  "size": "3rem" },
				{ "slug": "8",  "name": "8 (64px)",  "size": "4rem" },
				{ "slug": "9",  "name": "9 (96px)",  "size": "6rem" },
				{ "slug": "10", "name": "10 (128px)","size": "8rem" },
				{ "slug": "11", "name": "11 (192px)","size": "12rem" }
			],
			"defaultSpacingSizes": false
		},
		"custom": {
			"lineHeight": {
				"tight": 1.08,
				"snug": 1.24,
				"normal": 1.55,
				"loose": 1.7
			},
			"letterSpacing": {
				"tight": "-0.02em",
				"normal": "0",
				"caps": "0.14em"
			},
			"measure": {
				"narrow": "34rem",
				"body": "42rem",
				"wide": "60rem",
				"max": "84rem",
				"title": "34ch",
				"prose": "58ch"
			},
			"motion": {
				"duration": {
					"fast": "180ms",
					"base": "320ms",
					"slow": "640ms",
					"cinematic": "1200ms"
				},
				"easing": {
					"outQuart": "cubic-bezier(0.25, 1, 0.5, 1)",
					"inOutQuart": "cubic-bezier(0.76, 0, 0.24, 1)"
				}
			},
			"hairline": {
				"thin": "1px",
				"medium": "2px"
			}
		}
	},
	"styles": {
		"css": "html{font-size:112.5%;}",
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--text-on-paper)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--step-0)",
			"fontWeight": "400",
			"lineHeight": "var(--wp--custom--line-height--loose)"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "var(--wp--custom--line-height--tight)",
					"letterSpacing": "var(--wp--custom--letter-spacing--tight)",
					"fontSize": "clamp(var(--wp--preset--font-size--step-5), 5vw + 1rem, var(--wp--preset--font-size--step-8))"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "var(--wp--custom--line-height--tight)",
					"letterSpacing": "var(--wp--custom--letter-spacing--tight)",
					"fontSize": "clamp(var(--wp--preset--font-size--step-4), 3.5vw + 0.5rem, var(--wp--preset--font-size--step-6))"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "var(--wp--custom--line-height--tight)",
					"letterSpacing": "var(--wp--custom--letter-spacing--tight)",
					"fontSize": "var(--wp--preset--font-size--step-3)"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontWeight": "500",
					"letterSpacing": "var(--wp--custom--letter-spacing--caps)",
					"textTransform": "uppercase",
					"fontSize": "var(--wp--preset--font-size--step--1)"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontWeight": "500"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontWeight": "500"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--link-hover)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--link)"
					}
				}
			}
		}
	}
}
